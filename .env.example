# Copy to `.env.local` and adjust. All variables are optional and are baked in at
# build time by Vite, so never put secrets here — this file ships with the app.

# Base path the static build is served from. Defaults to "/crawlcheck/"
# (GitHub Pages project site). Use "/" for a root domain.
VITE_BASE=/crawlcheck/

# Optional default URL of a CrawlCheck scan service (see worker/).
# Users can still override it in the in-app settings.
VITE_SCAN_ENDPOINT=
