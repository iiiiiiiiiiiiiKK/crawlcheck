{
  "name": "crawlcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Know how crawlers see your website - technical SEO and crawler configuration checker",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "homepage": "https://iiiiiiiiiiiiiKK.github.io/crawlcheck/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiiiiiiiiiiiiKK/crawlcheck.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
